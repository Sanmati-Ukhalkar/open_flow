{
  "id": "text-transform",
  "displayName": "Text Transform",
  "icon": "Combine",
  "category": "Storage",
  "inputSchema": {
    "type": "object",
    "description": "Accepts any number of upstream node outputs keyed by node ID. Each value must have a { data } field. No specific shape is enforced — the node is a flexible string formatter.",
    "properties": {},
    "additionalProperties": {
      "type": "object",
      "properties": {
        "data": { "type": ["object", "string", "number", "boolean", "null"] }
      }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "data": {
        "type": "object",
        "properties": {
          "text": { "type": "string" }
        }
      }
    }
  },
  "capabilities": [],
  "configFields": [
    {
      "name": "template",
      "label": "Text Template",
      "type": "textarea",
      "required": true,
      "defaultValue": "Template with placeholders: {{llm-node-1}}",
      "placeholder": "Combined output: {{llm-node-1}} and {{mcp-node-1}}"
    }
  ]
}
