{
  "id": "llm-prompt",
  "displayName": "LLM Prompt",
  "icon": "Bot",
  "category": "AI",
  "inputSchema": {
    "type": "object",
    "properties": {}
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "data": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        }
      }
    }
