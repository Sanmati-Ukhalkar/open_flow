{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@open-flow/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@open-flow/engine": ["../../packages/engine/src/topoSort.ts"]
    }
  },
  "include": ["src", "vite.config.ts"],
  "references": []
}
