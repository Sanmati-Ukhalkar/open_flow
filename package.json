{
  "name": "open-flow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,worker,scheduler,web -c blue,magenta,yellow,cyan \"npm run dev -w apps/api\" \"npm run dev -w apps/worker\" \"npm run dev -w apps/scheduler\" \"npm run dev -w apps/web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:worker": "npm run dev -w apps/worker",
    "dev:scheduler": "npm run dev -w apps/scheduler",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "migrate": "npm run migrate -w packages/db",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages --ext .ts,.tsx"
  },
  "dependencies": {
    "bullmq": "^5.41.0",
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.5",
    "ioredis": "^5.6.0",
    "node-cron": "^3.0.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.14.9",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.2",
    "vitest": "^4.1.10"
  }
}
