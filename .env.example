OPENAI_API_KEY=your_openai_api_key_here    # Required by LLM Prompt node (gpt-4o, gpt-4o-mini)
GROQ_API_KEY=your_groq_api_key_here        # Required by LLM Prompt node (llama3, mixtral, gemma2)

# SMTP settings — required by Email node
SMTP_HOST=smtp.example.com                 # SMTP server hostname (e.g. smtp.gmail.com)
SMTP_PORT=587                              # SMTP port (587 for TLS, 465 for SSL)
SMTP_USER=your_email@example.com           # SMTP login username / email address
SMTP_PASS=your_smtp_app_password           # SMTP password or app-specific password

# Backend port
PORT=3001
