OPENAI_API_KEY=your_openai_api_key_here    # Required by LLM Prompt node (gpt-4o, gpt-4o-mini)
GROQ_API_KEY=your_groq_api_key_here        # Required by LLM Prompt node (llama3, mixtral, gemma2)

# SMTP settings — required by Email node
SMTP_HOST=smtp.example.com                 # SMTP server hostname (e.g. smtp.gmail.com)
SMTP_PORT=587                              # SMTP port (587 for TLS, 465 for SSL)
SMTP_USER=your_email@example.com           # SMTP login username / email address
SMTP_PASS=your_smtp_app_password           # SMTP password or app-specific password

# Backend & Job Queue Settings
PORT=3001
REDIS_URL=redis://127.0.0.1:6380           # Required by BullMQ worker & scheduler services

# Security & Cryptography (REQUIRED — app will refuse to boot without these; use random 32+ char secrets)
JWT_SECRET=your_jwt_secret_signing_key_here          # Required for signing user session tokens (e.g. generate via openssl rand -hex 32)
ENCRYPTION_KEY=your_32_byte_aes_encryption_key_here  # Required for AES-256-CBC encryption of sensitive credentials in database (never use placeholder)

# Telemetry & Distributed Tracing (Optional)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces   # OpenTelemetry OTLP exporter endpoint
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id       # Sentry error tracking & tracing DSN


