{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@open-flow/shared-types": ["packages/shared-types/src/index.ts"],
      "@open-flow/db": ["packages/db/src/index.ts"],
      "@open-flow/nodes": ["packages/nodes/src/index.ts"],
      "@open-flow/engine": ["packages/engine/src/index.ts"]
    }
  },
  "include": ["apps", "packages", "tests", "e2e"]
}
