{
  "id": "llm-prompt",
  "displayName": "LLM Prompt",
  "icon": "Bot",
  "category": "AI",
  "inputSchema": {
    "type": "object",
    "properties": {}
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string"
      }
    }
  },
  "configFields": [
    {
      "name": "promptText",
      "label": "Prompt",
      "type": "textarea",
      "required": true,
      "placeholder": "Enter your prompt template here..."
    },
    {
      "name": "model",
      "label": "Model",
      "type": "select",
      "required": true,
      "options": [
        { "value": "gpt-4o-mini", "label": "gpt-4o-mini (Recommended)" },
        { "value": "gpt-4o", "label": "gpt-4o" },
        { "value": "gpt-3.5-turbo", "label": "gpt-3.5-turbo" }
      ],
      "defaultValue": "gpt-4o-mini"
    }
  ]
}
