{
  "id": "llm-prompt",
  "displayName": "LLM Prompt",
  "icon": "Bot",
  "category": "AI",
  "inputSchema": {
    "type": "object",
    "properties": {}
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "data": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        }
      }
    }
  },
  "capabilities": ["network:fetch", "secrets:llm"],
  "configFields": [
    {
      "name": "promptText",
      "label": "Prompt",
      "type": "textarea",
      "required": true,
      "placeholder": "Enter your prompt template here..."
    },
    {
      "name": "model",
      "label": "Model",
      "type": "select",
      "required": true,
      "options": [
        { "value": "llama-3.1-8b-instant", "label": "Llama 3.1 8B (Groq - Recommended)" },
        { "value": "llama3-8b-8192", "label": "Llama 3 8B (Groq)" },
        { "value": "llama3-70b-8192", "label": "Llama 3 70B (Groq)" },
        { "value": "mixtral-8x7b-32768", "label": "Mixtral 8x7B (Groq)" },
        { "value": "gemma2-9b-it", "label": "Gemma 2 9B (Groq)" },
        { "value": "gpt-4o-mini", "label": "gpt-4o-mini (OpenAI)" },
        { "value": "gpt-4o", "label": "gpt-4o (OpenAI)" }
      ],
      "defaultValue": "llama-3.1-8b-instant"
    }
  ]
}
